---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import Intro from '../components/Intro.astro';
import Promo from '../components/Promo.astro';
import Socials from '../components/Socials.astro';
import Videos from '../components/Videos.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { profile } from '../data/profile';
import { t, defaultLang } from '../data/i18n';

const ticker = [
  'ZICO EFOOTBALL',
  'EFOOTBALL MOBILE',
  'COINS DONATE',
  'ACCOUNT SHOP',
  'PREMIUM',
];
---

<Layout title={`${profile.name} — eFootball Mobile`} description={t.tagline[defaultLang]}>
  <div class="stage">
    <div class="topbar">
      <Marquee items={ticker} />
      <LangSwitch />
    </div>

    <main class="stage-body">
      <Intro />
      <Promo />
      <Socials />
      <Videos />
    </main>

    <Marquee items={ticker} reverse />
  </div>
</Layout>

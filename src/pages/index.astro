---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import PhotoCard from '../components/PhotoCard.astro';
import Identity from '../components/Identity.astro';
import Socials from '../components/Socials.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { profile } from '../data/profile';
import { t, defaultLang } from '../data/i18n';

const ticker = [
  'ZICO EFOOTBALL',
  'EFOOTBALL MOBILE',
  `${profile.statValue}${profile.statSuffix} PREMIUM`,
  'COINS DONATE',
  'ACCOUNT SHOP',
];
---

<Layout title={`${profile.name} — eFootball Mobile`} description={t.tagline[defaultLang]}>
  <div class="stage">
    <div class="topbar">
      <Marquee items={ticker} />
      <LangSwitch />
    </div>

    <div class="stage-body">
      <PhotoCard />
      <Identity />
      <Socials />
    </div>

    <Marquee items={ticker} reverse />
  </div>
</Layout>

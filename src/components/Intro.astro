---
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="intro">
  <h1 class="name reveal" style="--d: 0.04s">
    <span>{profile.name}</span>
    <img class="badge" src="/badge.png" alt="Division 9 · 25-26" width="160" height="157" />
  </h1>
  <p class="tagline reveal" style="--d: 0.09s"><T text={t.tagline} /></p>

  <p class="stat reveal" style="--d: 0.14s">
    <span class="value" id="stat-value" data-target={profile.statValue} data-suffix={profile.statSuffix}>
      {profile.statValue}{profile.statSuffix}
    </span>
    <span class="label"><T text={t.statsLabel} /></span>
  </p>

  <p class="bio reveal" style="--d: 0.19s"><T text={t.bio} block /></p>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.2rem, 0.7vh, 0.45rem);
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--edge);
    min-width: 0;
  }

  .name {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    margin: 0;
    line-height: 1;
    font-size: clamp(1.05rem, 2.7vh, 1.7rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Значок дивизиона — размер привязан к кеглю имени, чтобы масштабировался вместе с ним. */
  .badge {
    width: auto;
    height: 1.65em;
    flex-shrink: 0;
    /* последняя буква имени отбита трекингом — компенсируем, иначе зазор кажется больше */
    margin-left: -0.16em;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }

  .tagline {
    margin: 0;
    font-size: clamp(0.72rem, 1.7vh, 0.92rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  /* Цифра и подпись в одну строку — вертикальная вёрстка съедала бы высоту,
     которая нужна ссылкам и роликам ниже. */
  .stat {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: clamp(0.1rem, 0.5vh, 0.3rem) 0 0;
  }

  .value {
    font-size: clamp(1.3rem, 3.4vh, 2rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(120deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .label {
    font-size: clamp(0.64rem, 1.45vh, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bio {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(0.7rem, 1.6vh, 0.88rem);
    line-height: 1.45;
    color: var(--muted);
  }
</style>

<script>
  // Счётчик добегает до значения один раз при загрузке.
  const el = document.getElementById('stat-value');
  const target = Number(el?.dataset.target ?? 0);

  if (el && target > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const suffix = el.dataset.suffix ?? '';
    const duration = 1100;
    let start = 0;

    const step = (now: number) => {
      if (!start) start = now;
      const p = Math.min((now - start) / duration, 1);
      // easeOutExpo — быстрый разгон и мягкая остановка на финальном числе
      const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
      el.textContent = Math.round(target * eased) + suffix;
      if (p < 1) requestAnimationFrame(step);
    };

    el.textContent = '0' + suffix;
    requestAnimationFrame(step);
  }
</script>

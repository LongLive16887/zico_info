---
import { langs, type Lang } from '../data/i18n';

interface Props {
  text: Record<Lang, string>;
  block?: boolean;
}
const { text, block } = Astro.props as Props;
const cls = block ? 'i18n i18n-block' : 'i18n';
---

{/* Все варианты рендерятся сразу, видимый выбирает CSS по data-lang на <html>:
    переключение мгновенное и работает даже без JS. */}
{langs.map((lang) => <span class={cls} data-lang={lang} set:text={text[lang]} />)}

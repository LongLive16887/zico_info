---
import { langFromUrl, type Lang } from '../data/i18n';

interface Props {
  text: Record<Lang, string>;
}
const { text } = Astro.props as Props;
const lang = langFromUrl(Astro.url);
---

{/* В HTML — только текст на языке страницы: его и видит поисковик, у каждого языка свой адрес.
    Остальные переводы лежат в data-i18n — переключатель подставляет их на месте, без перезагрузки. */}
<span data-i18n={JSON.stringify(text)} set:text={text[lang]} />

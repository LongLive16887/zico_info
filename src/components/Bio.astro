---
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="bio reveal">
  <p><T text={t.bio} block /></p>
</section>

<style>
  .bio {
    max-width: 460px;
    margin: 0 auto;
    padding: 0 1.2rem clamp(0.6rem, 2vh, 1.1rem);
    text-align: center;
  }

  p {
    margin: 0;
    font-size: clamp(0.78rem, 1.7vh, 0.92rem);
    line-height: 1.45;
    color: var(--text);
  }
</style>

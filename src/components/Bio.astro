---
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="bio reveal">
  <h2><T text={t.bioTitle} /></h2>
  <p><T text={t.bio} block /></p>
</section>

<style>
  .bio {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 1.5rem 2.5rem;
    text-align: center;
  }

  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  p {
    margin: 0;
    line-height: 1.6;
    color: var(--text);
  }
</style>

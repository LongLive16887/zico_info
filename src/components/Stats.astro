---
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="stats">
  <div class="stat reveal">
    <span class="value">{profile.statValue}</span>
    <span class="label"><T text={t.statsLabel} /></span>
  </div>
</section>

<style>
  .stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0 1.2rem clamp(0.6rem, 2vh, 1.1rem);
  }

  .stat {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(0.5rem, 1.4vh, 0.8rem) 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 150px;
    transition: border-color 0.3s ease;
  }

  .stat:hover {
    border-color: var(--accent);
  }

  .value {
    font-size: clamp(1.2rem, 2.6vh, 1.6rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-image 0.4s ease;
  }

  .label {
    color: var(--muted);
    font-size: clamp(0.7rem, 1.4vh, 0.8rem);
    margin-top: 0.15rem;
  }
</style>

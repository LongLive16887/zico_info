---
import { langs } from '../data/i18n';
---

<div class="lang-switch">
  {langs.map((l) => <button type="button" data-set-lang={l}>{l.toUpperCase()}</button>)}
</div>

<style>
  /* В потоке, отдельной полосой: fixed-вариант перекрывал фото на узких экранах. */
  .lang-switch {
    display: flex;
    gap: 0.15rem;
    background: rgba(10, 10, 16, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--stroke);
    border-radius: 999px;
    padding: 0.22rem;
  }

  button {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: clamp(0.62rem, 1.4vh, 0.72rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  button:hover {
    color: var(--ink);
  }

  button[aria-current='true'] {
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    color: #0a0a10;
  }
</style>

<script>
  const KEY = 'zico-lang';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-lang]');

  function apply(lang: string) {
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang);
    buttons.forEach((b) => b.setAttribute('aria-current', String(b.dataset.setLang === lang)));
  }

  // Язык уже проставлен блокирующим скриптом в <head> — здесь только подсвечиваем активную кнопку.
  apply(document.documentElement.getAttribute('data-lang')!);

  buttons.forEach((b) => {
    b.addEventListener('click', () => {
      const lang = b.dataset.setLang!;
      localStorage.setItem(KEY, lang); // выбор запоминается между визитами
      apply(lang);
    });
  });
</script>

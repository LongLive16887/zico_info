---
import { langs, pathFor, langFromUrl, t } from '../data/i18n';

const current = langFromUrl(Astro.url);
---

{/* Ссылки, а не кнопки: у каждого языка свой адрес, и поисковик находит все версии по ним.
    Скрипт ниже перехватывает клик и меняет язык на месте, без перезагрузки. */}
<div class="lang-switch" data-titles={JSON.stringify(t.metaTitle)}>
  {
    langs.map((l) => (
      <a
        href={pathFor(l)}
        hreflang={l}
        lang={l}
        data-set-lang={l}
        aria-current={l === current ? 'page' : undefined}
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</div>

<style>
  /* В потоке, отдельной полосой: fixed-вариант перекрывал фото на узких экранах. */
  .lang-switch {
    display: flex;
    gap: 0.15rem;
    background: rgba(10, 10, 16, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--stroke);
    border-radius: 999px;
    padding: 0.22rem;
  }

  a {
    display: inline-block;
    color: var(--muted);
    font-size: clamp(0.62rem, 1.4vh, 0.72rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  a:hover {
    color: var(--ink);
  }

  a[aria-current='page'] {
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    color: #0a0a10;
  }
</style>

<script>
  import type { Lang } from '../data/i18n';

  const KEY = 'zico-lang';
  const root = document.querySelector<HTMLElement>('.lang-switch')!;
  const links = root.querySelectorAll<HTMLAnchorElement>('[data-set-lang]');
  const titles: Record<Lang, string> = JSON.parse(root.dataset.titles!);

  function apply(lang: Lang, href: string) {
    document.documentElement.setAttribute('lang', lang);
    document.title = titles[lang];
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      el.textContent = JSON.parse(el.dataset.i18n!)[lang];
    });
    links.forEach((a) => {
      if (a.dataset.setLang === lang) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    // replace, а не push: «назад» уводит с сайта, а не перебирает языки
    history.replaceState(null, '', href);
  }

  links.forEach((a) => {
    a.addEventListener('click', (e) => {
      // Ctrl/Cmd/Shift-клик — открыть язык в новой вкладке, как обычную ссылку
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const lang = a.dataset.setLang as Lang;
      try {
        localStorage.setItem(KEY, lang); // выбор запоминается между визитами
      } catch {
        // без хранилища (приватный режим) язык просто не запомнится
      }
      apply(lang, a.getAttribute('href')!);
    });
  });
</script>

---
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="hero">
  <div class="photo-wrap reveal delay-0">
    <div class="ring"></div>
    <div class="hero-photo" id="hero-photo-tilt">
      <img id="hero-photo-img" src={profile.photo} alt={profile.name} width="240" height="240" crossorigin="anonymous" />
    </div>
  </div>
  <h1 class="reveal delay-1">{profile.name}</h1>
  <p class="tagline reveal delay-2"><T text={t.tagline} /></p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4.5rem 1.5rem 2.5rem;
    gap: 1rem;
  }

  .photo-wrap {
    position: relative;
    width: 240px;
    height: 240px;
    display: grid;
    place-items: center;
  }

  /* Вращающееся кольцо со свечением вокруг фото — только transform, дёшево для GPU. */
  .ring {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), var(--accent-2), var(--accent));
    filter: blur(10px);
    opacity: 0.8;
    animation: spin 8s linear infinite;
    will-change: transform;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-photo {
    position: relative;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--bg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.9rem);
    margin: 0.2rem 0 0;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .tagline {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .delay-0 {
    transition-delay: 0s;
  }
  .delay-1 {
    transition-delay: 0.08s;
  }
  .delay-2 {
    transition-delay: 0.16s;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }
</style>

<script>
  // Tilt на фото по позиции курсора — чисто transform, без reflow, throttled через rAF.
  const wrap = document.getElementById('hero-photo-tilt');
  if (wrap) {
    let raf = 0;
    let targetX = 0;
    let targetY = 0;

    const apply = () => {
      wrap.style.transform = `perspective(600px) rotateX(${targetY}deg) rotateY(${targetX}deg)`;
      raf = 0;
    };

    wrap.addEventListener('pointermove', (e) => {
      const rect = wrap.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width - 0.5;
      const py = (e.clientY - rect.top) / rect.height - 0.5;
      targetX = px * 18;
      targetY = -py * 18;
      if (!raf) raf = requestAnimationFrame(apply);
    });

    wrap.addEventListener('pointerleave', () => {
      wrap.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg)';
    });
  }

  // Извлекаем усреднённые цвета фото и красим ими --accent/--accent-2 — палитра сайта следует за фото.
  const img = document.getElementById('hero-photo-img') as HTMLImageElement | null;

  function extractPalette(image: HTMLImageElement) {
    try {
      const size = 24;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.drawImage(image, 0, 0, size, size);
      const { data } = ctx.getImageData(0, 0, size, size);

      let r1 = 0, g1 = 0, b1 = 0, n1 = 0; // светлые/тёплые пиксели
      let r2 = 0, g2 = 0, b2 = 0, n2 = 0; // тёмные/холодные пиксели

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i], g = data[i + 1], b = data[i + 2], a = data[i + 3];
        if (a < 128) continue;
        const brightness = (r + g + b) / 3;
        if (brightness >= 96) {
          r1 += r; g1 += g; b1 += b; n1++;
        } else {
          r2 += r; g2 += g; b2 += b; n2++;
        }
      }

      const mix = (r: number, g: number, b: number, n: number, fallback: string) =>
        n > 0 ? `rgb(${Math.round(r / n)}, ${Math.round(g / n)}, ${Math.round(b / n)})` : fallback;

      const accent = mix(r1, g1, b1, n1, '#5b8cff');
      const accent2 = mix(r2, g2, b2, n2, '#ff5b9e');

      document.documentElement.style.setProperty('--accent', accent);
      document.documentElement.style.setProperty('--accent-2', accent2);
    } catch {
      // CORS/decode ошибки — просто оставляем статичную палитру по умолчанию.
    }
  }

  if (img) {
    if (img.complete) extractPalette(img);
    else img.addEventListener('load', () => extractPalette(img));
  }
</script>

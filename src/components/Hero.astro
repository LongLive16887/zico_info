---
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="hero">
  <div class="hero-photo reveal delay-0">
    <img src={profile.photo} alt={profile.name} width="220" height="220" />
  </div>
  <h1 class="reveal delay-1">{profile.name}</h1>
  <p class="tagline reveal delay-2"><T text={t.tagline} /></p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4.5rem 1.5rem 2.5rem;
    gap: 0.9rem;
  }

  .hero-photo {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--border);
    box-shadow: 0 0 0 6px rgba(91, 140, 255, 0.08);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin: 0.2rem 0 0;
    letter-spacing: -0.02em;
  }

  .tagline {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .delay-0 {
    transition-delay: 0s;
  }
  .delay-1 {
    transition-delay: 0.08s;
  }
  .delay-2 {
    transition-delay: 0.16s;
  }
</style>

---
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import T from './T.astro';
---

<section class="hero">
  <div class="photo-wrap reveal delay-0">
    <div class="pulse"></div>
    <div class="pulse pulse-2"></div>
    <div class="pulse pulse-3"></div>
    <div class="ring"></div>
    <div class="hero-photo" id="hero-photo-tilt">
      <img id="hero-photo-img" src={profile.photo} alt={profile.name} width="120" height="120" crossorigin="anonymous" />
    </div>
  </div>
  <h1 class="reveal delay-1">{profile.name}</h1>
  <p class="tagline reveal delay-2"><T text={t.tagline} /></p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(0.8rem, 3vh, 1.6rem) 1.2rem clamp(0.6rem, 2vh, 1rem);
    gap: 0.35rem;
  }

  .photo-wrap {
    position: relative;
    width: clamp(84px, 16vh, 120px);
    height: clamp(84px, 16vh, 120px);
    display: grid;
    place-items: center;
    margin-bottom: 0.3rem;
  }

  /* Кольца, расходящиеся от аватара — только transform/opacity. */
  .pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--accent-2);
    opacity: 0;
    animation: pulse-out 3.6s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
    will-change: transform, opacity;
    pointer-events: none;
  }

  .pulse-2 {
    animation-delay: 1.2s;
  }

  .pulse-3 {
    animation-delay: 2.4s;
  }

  @keyframes pulse-out {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  /* Вращающееся кольцо со свечением вокруг фото — только transform, дёшево для GPU. */
  .ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), var(--accent-2), var(--accent));
    filter: blur(10px);
    opacity: 0.8;
    animation: spin 8s linear infinite;
    will-change: transform;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-photo {
    position: relative;
    width: clamp(84px, 16vh, 120px);
    height: clamp(84px, 16vh, 120px);
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: clamp(1.3rem, 3.4vh, 1.9rem);
    margin: 0;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .tagline {
    color: var(--muted);
    font-size: clamp(0.8rem, 1.8vh, 0.95rem);
    margin: 0;
  }

  .delay-0 {
    transition-delay: 0s;
  }
  .delay-1 {
    transition-delay: 0.08s;
  }
  .delay-2 {
    transition-delay: 0.16s;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .pulse {
      animation: none;
    }

    .pulse {
      display: none;
    }
  }
</style>

<script>
  // Tilt на фото по позиции курсора — чисто transform, без reflow, throttled через rAF.
  const wrap = document.getElementById('hero-photo-tilt');
  if (wrap) {
    let raf = 0;
    let targetX = 0;
    let targetY = 0;

    const apply = () => {
      wrap.style.transform = `perspective(600px) rotateX(${targetY}deg) rotateY(${targetX}deg)`;
      raf = 0;
    };

    wrap.addEventListener('pointermove', (e) => {
      const rect = wrap.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width - 0.5;
      const py = (e.clientY - rect.top) / rect.height - 0.5;
      targetX = px * 18;
      targetY = -py * 18;
      if (!raf) raf = requestAnimationFrame(apply);
    });

    wrap.addEventListener('pointerleave', () => {
      wrap.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg)';
    });
  }

  // Извлекаем доминирующие НАСЫЩЕННЫЕ оттенки фото (не просто среднее — иначе яркие
  // фото уходят в грязно-серый) и красим ими --accent/--accent-2. Палитра сайта следует за фото.
  const img = document.getElementById('hero-photo-img') as HTMLImageElement | null;

  function rgbToHsl(r: number, g: number, b: number) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    const l = (max + min) / 2;
    if (max === min) return { h: 0, s: 0, l };
    const d = max - min;
    const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    let h = 0;
    if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) * 60;
    else if (max === g) h = ((b - r) / d + 2) * 60;
    else h = ((r - g) / d + 4) * 60;
    return { h, s, l };
  }

  function hslToCss(h: number, s: number, l: number) {
    return `hsl(${Math.round(h)}deg ${Math.round(s * 100)}% ${Math.round(l * 100)}%)`;
  }

  function extractPalette(image: HTMLImageElement) {
    try {
      const size = 32;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.drawImage(image, 0, 0, size, size);
      const { data } = ctx.getImageData(0, 0, size, size);

      const buckets = 24; // шаг 15°
      const weight = new Array(buckets).fill(0);
      const sumH: number[] = new Array(buckets).fill(0);
      const sumS: number[] = new Array(buckets).fill(0);
      const sumL: number[] = new Array(buckets).fill(0);
      const count: number[] = new Array(buckets).fill(0);

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i], g = data[i + 1], b = data[i + 2], a = data[i + 3];
        if (a < 128) continue;
        const { h, s, l } = rgbToHsl(r, g, b);
        // Отбрасываем почти-серые/почти-чёрные/почти-белые пиксели — фон/тени не должны рулить палитрой.
        if (s < 0.35 || l < 0.12 || l > 0.9) continue;
        const bucket = Math.floor(h / (360 / buckets)) % buckets;
        const w = s; // насыщенность как вес — доминируют яркие цвета, а не просто частые
        weight[bucket] += w;
        sumH[bucket] += h * w;
        sumS[bucket] += s * w;
        sumL[bucket] += l * w;
        count[bucket]++;
      }

      const order = weight
        .map((w, i) => ({ w, i }))
        .filter((b) => b.w > 0)
        .sort((a, b) => b.w - a.w);

      if (order.length === 0) return; // недостаточно цвета (например, ч/б плейсхолдер) — оставляем дефолт

      const hueOf = (i: number) => sumH[i] / weight[i];
      const satOf = (i: number) => sumS[i] / weight[i];
      const toColor = (i: number) => hslToCss(hueOf(i), satOf(i), Math.min(Math.max(sumL[i] / weight[i], 0.5), 0.62));

      const top = order[0].i;
      const accent = toColor(top);

      // Оттенки 55–160° (лайм/зелень) рядом с тёплым основным читаются грязно, поэтому
      // для второго акцента берём только гармоничного соседа (25–75° по кругу) вне этой зоны.
      const warm = hueOf(top) < 55 || hueOf(top) > 330;
      const second = order.find((b) => {
        if (b.i === top) return false;
        const raw = Math.abs(hueOf(b.i) - hueOf(top));
        const dh = Math.min(raw, 360 - raw);
        if (dh < 25 || dh > 75) return false;
        const h = hueOf(b.i);
        return !(warm && h > 55 && h < 160);
      });

      // Фолбэк — аналоговый сдвиг в сторону красного: для огненных фото даёт живой оранж→красный дуотон.
      const accent2 = second
        ? toColor(second.i)
        : hslToCss((hueOf(top) - 22 + 360) % 360, satOf(top), 0.55);

      document.documentElement.style.setProperty('--accent', accent);
      document.documentElement.style.setProperty('--accent-2', accent2);
    } catch {
      // CORS/decode ошибки — просто оставляем статичную палитру по умолчанию.
    }
  }

  if (img) {
    if (img.complete) extractPalette(img);
    else img.addEventListener('load', () => extractPalette(img));
  }
</script>

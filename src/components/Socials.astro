---
import { socials } from '../data/profile';
import Icon from './Icon.astro';
---

<nav class="socials">
  {
    socials.map((s, i) => (
      <a
        class="social reveal"
        href={s.url}
        target="_blank"
        rel="noopener noreferrer"
        style={`--brand: ${s.color}; --d: ${0.38 + i * 0.05}s`}
      >
        <span class="glow" />
        <span class="icon">
          <Icon name={s.icon as any} />
        </span>
        <span class="name">{s.name}</span>
        <span class="arrow">↗</span>
      </a>
    ))
  }
</nav>

<style>
  .socials {
    grid-area: socials;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.4rem, 1.3vh, 0.7rem);
    width: 100%;
    max-width: 1120px;
  }

  @media (min-width: 800px) {
    .socials {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      margin-top: clamp(0.4rem, 2.2vh, 1.4rem);
      gap: clamp(0.5rem, 1.6vh, 0.9rem);
    }

    .social {
      padding: clamp(0.7rem, 2.2vh, 1.15rem) 0.5rem;
      gap: 0.45rem;
    }

    .icon {
      width: clamp(20px, 3.6vh, 28px);
      height: clamp(20px, 3.6vh, 28px);
    }

    .name {
      font-size: clamp(0.72rem, 1.7vh, 0.9rem);
    }
  }

  .social {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: clamp(0.5rem, 1.7vh, 0.9rem) 0.4rem;
    background: var(--glass);
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: center;
    isolation: isolate;
    transition: border-color 0.25s ease, background-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Заливка брендовым цветом всплывает снизу при наведении. */
  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 130%, var(--brand), transparent 68%);
    opacity: 0;
    transform: translateY(35%);
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social:hover,
  .social:focus-visible {
    border-color: color-mix(in srgb, var(--brand) 60%, transparent);
    background: rgba(255, 255, 255, 0.06);
  }

  .social:hover .glow,
  .social:focus-visible .glow {
    opacity: 0.36;
    transform: translateY(0);
  }

  .icon {
    width: clamp(17px, 3.2vh, 23px);
    height: clamp(17px, 3.2vh, 23px);
    color: var(--brand);
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--brand) 55%, transparent));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social:hover .icon {
    transform: translateY(-2px) scale(1.12);
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .name {
    font-weight: 600;
    font-size: clamp(0.64rem, 1.45vh, 0.8rem);
    line-height: 1.15;
  }

  .arrow {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 0.62rem;
    color: var(--muted);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .social:hover .arrow,
  .social:focus-visible .arrow {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>

<script>
  // Магнитный ховер: карточка чуть тянется к курсору. Пишем transform раз в кадр.
  if (matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.social').forEach((el) => {
      let raf = 0;
      let x = 0;
      let y = 0;

      const write = () => {
        el.style.transform = `translate(${x}px, ${y}px)`;
        raf = 0;
      };

      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        x = ((e.clientX - r.left) / r.width - 0.5) * 10;
        y = ((e.clientY - r.top) / r.height - 0.5) * 10 - 3;
        if (!raf) raf = requestAnimationFrame(write);
      });

      el.addEventListener('pointerleave', () => {
        x = 0;
        y = 0;
        if (!raf) raf = requestAnimationFrame(write);
      });
    });
  }
</script>

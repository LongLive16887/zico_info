---
// Детерминированный псевдослучайный генератор — одинаковый результат при каждой сборке (SSR, без гидратации).
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(42);
const count = 22;
const embers = Array.from({ length: count }, () => ({
  left: (rand() * 100).toFixed(1),
  size: (2 + rand() * 4).toFixed(1),
  duration: (7 + rand() * 9).toFixed(1),
  delay: (-rand() * 16).toFixed(1),
  drift: (rand() * 60 - 30).toFixed(0),
}));
---

<div class="embers" aria-hidden="true">
  {
    embers.map((e) => (
      <span
        style={`left:${e.left}%; --size:${e.size}px; --duration:${e.duration}s; --delay:${e.delay}s; --drift:${e.drift}px;`}
      />
    ))
  }
</div>

<style>
  .embers {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .embers span {
    position: absolute;
    bottom: -5vh;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent) 0%, var(--accent-2) 55%, transparent 75%);
    box-shadow: 0 0 6px var(--accent), 0 0 14px var(--accent-2);
    opacity: 0;
    animation: ember-rise var(--duration) linear infinite;
    animation-delay: var(--delay);
    will-change: transform, opacity;
  }

  @keyframes ember-rise {
    0% {
      transform: translate(0, 0) scale(0.5);
      opacity: 0;
    }
    12% {
      opacity: 0.9;
    }
    50% {
      transform: translate(var(--drift), -55vh) scale(1);
      opacity: 0.7;
    }
    100% {
      transform: translate(calc(var(--drift) * -1), -112vh) scale(0.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .embers {
      display: none;
    }
  }
</style>

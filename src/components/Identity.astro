---
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import T from './T.astro';
---

<div class="identity">
  <h1 class="name reveal" style="--d: 0.16s">{profile.name}</h1>

  <p class="tagline reveal" style="--d: 0.2s"><T text={t.tagline} /></p>

  <div class="stat reveal" style="--d: 0.26s">
    <span class="value" id="stat-value" data-target={profile.statValue} data-suffix={profile.statSuffix}>
      {profile.statValue}{profile.statSuffix}
    </span>
    <span class="label"><T text={t.statsLabel} /></span>
  </div>

  <p class="bio reveal" style="--d: 0.32s"><T text={t.bio} block /></p>
</div>

<style>
  .identity {
    grid-area: identity;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.3rem, 1vh, 0.6rem);
    min-width: 0;
  }

  @media (min-width: 800px) {
    .identity {
      align-items: flex-start;
      text-align: left;
      /* Колонка тянется по высоте арта — центрируем содержимое, иначе оно липнет к верху. */
      justify-content: center;
      gap: clamp(0.4rem, 1.4vh, 0.9rem);
    }

    .name {
      font-size: clamp(1.15rem, 2.9vh, 1.8rem);
    }

    .tagline {
      font-size: clamp(0.82rem, 2vh, 1.05rem);
    }

    .bio {
      font-size: clamp(0.8rem, 1.9vh, 1.02rem);
    }

    .value {
      font-size: clamp(3rem, 10vh, 6.5rem);
    }

    .label {
      font-size: clamp(0.72rem, 1.75vh, 0.95rem);
    }
  }

  /* Имя набрано сдержанно: оно уже крупно написано на самом арте,
     второй огромный дубль спорил бы с картинкой. */
  .name {
    margin: 0;
    line-height: 1;
    font-size: clamp(0.95rem, 2.5vh, 1.5rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .tagline {
    margin: 0;
    font-size: clamp(0.72rem, 1.7vh, 0.92rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--muted);
  }

  .bio {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(0.72rem, 1.65vh, 0.9rem);
    line-height: 1.5;
    color: var(--muted);
  }

  /* Цифра — смысловой акцент блока: это то, чего нет на арте. */
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    margin-top: clamp(0.1rem, 0.7vh, 0.4rem);
  }

  @media (min-width: 800px) {
    .stat {
      align-items: flex-start;
    }
  }

  .value {
    font-size: clamp(2.4rem, 8vh, 5.2rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(120deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .label {
    font-size: clamp(0.66rem, 1.55vh, 0.85rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

</style>

<script>
  // Счётчик добегает до значения один раз при загрузке.
  const el = document.getElementById('stat-value');
  const target = Number(el?.dataset.target ?? 0);

  if (el && target > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const suffix = el.dataset.suffix ?? '';
    const duration = 1100;
    let start = 0;

    const step = (now: number) => {
      if (!start) start = now;
      const p = Math.min((now - start) / duration, 1);
      // easeOutExpo — быстрый разгон и мягкая остановка на финальном числе
      const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
      el.textContent = Math.round(target * eased) + suffix;
      if (p < 1) requestAnimationFrame(step);
    };

    el.textContent = '0' + suffix;
    requestAnimationFrame(step);
  }
</script>
